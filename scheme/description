biigendian

запись в регистры T,S,A,B,R через bus

непересекающиеся виды микрокодов:
	 1) goto + условие
	 2) инеремент/декремент регистров
	 3) работа с памятью
	 4) ALU и перенос данных

ifetch
	mem_address <- pc[31:2]; mem_read
	cmd <- mem_in << pc[1:0]*8
	pc += 1

TODO: select instruction

<value>  dataStack.push(<value>)
	dsp -= 4
	mem_out <- S
	mem_address <- dsp[31:2]; mem_write
	S <- T
	mem_address <- pc[31:2]; mem_read
	T <- mem_in << pc[1:0]*8
	pc += 4
	if pc[1:0] == 0; goto ifetch
	mem_address <- pc[31:2]; mem_read
	T <- mem_in >> (4-pc[1:0])*8 | T
	goto ifetch


@p  dataStack.push(mem[<address>])
	dsp -= 4
	mem_out <- S
	mem_address <- dsp[31:2]; mem_write
	S <- T
	mem_address <- pc[31:2]; mem_read
	buffer <- mem_in << pc[1:0]*8
	pc += 4
	if pc[1:0] == 0; goto @p_fetch
	mem_address <- pc[31:2]; mem_read
	buffer <- mem_in >> (4-pc[1:0])*8 | buffer
@p_fetch
	mem_address <- buffer[31:2]; mem_read
	T <- mem_in << buffer[1:0]*8
	if buffer[1:0] == 0; goto ifetch
	mem_address <- buffer[31:2]+4; mem_read
	T <- mem_in >> (4-buffer[1:0])*8 | T
	goto ifetch


@  dataStack.push(mem[A])
	dsp -= 4
	mem_out <- S
	mem_address <- dsp[31:2]; mem_write
	S <- T
	mem_address <- A[31:2]; mem_read
	T <- mem_in << A[1:0]*8
	if A[1:0] == 0; goto ifetch
	mem_address <- A[31:2]+4; mem_read
	T <- mem_in >> (4-A[1:0])*8 | T
	goto ifetch


@+  dataStack.push(mem[A]); A <- A + 1
	dsp -= 4
	mem_out <- S
	mem_address <- dsp[31:2]; mem_write
	S <- T
	mem_address <- A[31:2]; mem_read
	T <- mem_in << A[1:0]*8
	if A[1:0] == 0; goto ifetch
	mem_address <- A[31:2]+4; mem_read
	T <- mem_in >> (4-A[1:0])*8 | T
	ALU <- A; ALU <- 1; +; A <- ALU
	goto ifetch


@b  dataStack.push(mem[B])
	mem_address <- B[31:2]; mem_read
	buffer <- mem_in
	dsp -= 4
	mem_out <- S
	mem_address <- dsp[31:2]; mem_write
	S <- T
	T <- buffer
	goto ifetch


!p <address>  mem[<address>] <- dataStack.pop()
	mem_address <- pc[31:2]; mem_read
	buffer <- mem_in << pc[1:0]*8
	pc += 4
	if pc[1:0] == 0; goto !p_pop
	mem_address <- pc[31:2]; mem_read
	buffer <- mem_in >> (4-pc[1:0])*8 | buffer
!p_pop
	if buffer[1:0] == 0; goto !p_aligned
	mem_address <- buffer[31:2]; mem_read
	mem_out <- T >> buffer[1:0]*8 | mem_in & 0xffffffff << (4-buffer[1:0])*8
	mem_address <- buffser[31:2]; mem_write
	mem_address <- buffer[31:2] + 4; mem_read
	mem_out <- T << (4-buffer[1:0])*8 | mem_in & 0xffffffff >> buffer[1:0]*8
	mem_address <- buffer[31:2] + 4; mem_write
	goto !p_continue
!p_aligned
	mem_out <- T
	mem_address <- buffer[31:2]; mem_write
!p_continue
	T <- S
	mem_address <- dsp[31:2]; mem_read
	S <- mem_in
	dsp += 4
	goto ifetch


!  mem[A] <- dataStack.pop()
	if buffer[1:0] == 0; goto !_aligned
	mem_address <- A[31:2]; mem_read
	mem_out <- T >> buffer[1:0]*8 | mem_in & 0xffffffff << (4-A[1:0])*8
	mem_address <- A[31:2]; mem_write
	mem_address <- A[31:2] + 4; mem_read
	mem_out <- T << (4-buffer[1:0])*8 | mem_in & 0xffffffff >> A[1:0]*8
	mem_address <- A[31:2] + 4; mem_write
	goto !_continue
!_aligned
	mem_out <- T
	mem_address <- A[31:2]; mem_write
!_continue
	T <- S
	mem_address <- dsp[31:2]; mem_read
	S <- mem_in
	dps += 4
	goto ifetch


!+  mem[A] <- dataStack.pop(); A <- A + 1
	if buffer[1:0] == 0; goto !_aligned
	mem_address <- A[31:2]; mem_read
	mem_out <- T >> buffer[1:0]*8 | mem_in & 0xffffffff << (4-A[1:0])*8
	mem_address <- A[31:2]; mem_write
	mem_address <- A[31:2] + 4; mem_read
	mem_out <- T << (4-buffer[1:0])*8 | mem_in & 0xffffffff >> A[1:0]*8
	mem_address <- A[31:2] + 4; mem_write
	goto !_continue
!_aligned
	mem_out <- T
	mem_address <- A[31:2]; mem_write
!_continue
	T <- S
	mem_address <- dsp[31:2]; mem_read
	S <- mem_in
	dps += 4
  ALU <- A; ALU <- 1; +; A <- ALU
	goto ifetch


!b  mem[B] <- dataStack.pop()
	if buffer[1:0] == 0; goto !_aligned
	mem_address <- B[31:2]; mem_read
	mem_out <- T >> buffer[1:0]*8 | mem_in & 0xffffffff << (4-B[1:0])*8
	mem_address <- B[31:2]; mem_write
	mem_address <- B[31:2] + 4; mem_read
	mem_out <- T << (4-buffer[1:0])*8 | mem_in & 0xffffffff >> B[1:0]*8
	mem_address <- B[31:2] + 4; mem_write
	goto !_continue
!_aligned
	mem_out <- T
	mem_address <- B[31:2]; mem_write
!_continue
	T <- S
	mem_address <- dsp[31:2]; mem_read
	S <- mem_in
	dps += 4
	goto ifetch


a!  A <- dataStack.pop()
	A <- T
	T <- S
	mem_address <- dsp[31:2]; mem_read
	S <- mem_in
	dsp += 4
	goto ifetch


b!  B <- dataStack.pop()
	B <- T
	T <- S
	mem_address <- dsp[31:2]; mem_read
	S <- mem_in
	dsp += 4
	goto ifetch


a  dataStack.push(A)
	dsp -= 4
	mem_out <- S
	mem_address <- dsp[31:2]; mem_write
	S <- T
	T <- A
	goto ifetch


+*  T <- T + (if A[0] then S else 0); A <- A >> 1; if T[0] then A[31] <- 1 else A[31] <- 0; T <- T >> 1
	if A[0] == 0; goto +*_1
	ALU <- T; ALU <- S; +; T <- ALU
+*_1
	ALU <- A; >>; A <- ALU
	A[31] <- T[0]
	ALU <- T; >>; T <- ALU
	goto ifetch


+/ TODO


2*  dataStack.push(dataStack.pop() << 1)
	ALU <- T; <<; T <- ALU
	goto ifetch


2/  dataStack.push(dataStack.pop() >> 1)
	ALU <- T; >>; T <- ALU
	goto ifetch


inv  dataStack.push(~dataStack.pop())
	ALU <- T; ~; T <- ALU
	goto ifetch


eam  eam <- dataStack.pop()
	eam <- T[0]
	T <- S
	mem_address <- dsp[31:2]; mem_read
	S <- mem_in
	dsp += 4
	goto ifetch


and  dataStack.push(dataStack.pop() & dataStack.pop())
	ALU <- T; ALU <- S; &; T <- ALU
	mem_address <- dsp[31:2]; mem_read
	S <- mem_in
	dsp += 4
	goto ifetch


xor  dataStack.push(dataStack.pop() ^ dataStack.pop())
	ALU <- T; ALU <- S; ^; T <- ALU
	mem_address <- dsp[31:2]; mem_read
	S <- mem_in
	dsp += 4
	goto ifetch


drop  dataStack.pop()
	T <- S
	mem_address <- dsp[31:2]; mem_read
	S <- mem_in
	dsp += 4
	goto ifetch


dup  dataStack.push(dataStack.top()), carry flag does not change
	dsp -= 4
	mem_out <- S
	mem_address <- dsp[31:2]; mem_write
	S <- T
	goto ifetch


over  T <- dataStack.pop(); S <- dataStack.pop(); dataStack.push(S); dataStack.push(T); dataStack.push(S)
	dsp -= 4
	mem_out <- S
	mem_address <- dsp[31:2]; mem_write
	buffer <- T
	T <- S
	S <- buffer
	goto ifetch


;  p <- returnStack.pop()
	mem_address <- rsp[31:2]; mem_read
	pc <- mem_in
	rsp += 4
	goto ifetch


<label>  returnStack.push(p); p <- <label>
	mem_address <- pc[31:2]; mem_read
	buffer <- mem_in << pc[1:0]*8
	pc += 4
	if pc[1:0] == 0; goto <label>_push
	mem_address <- pc[31:2]; mem_read
	buffer <- mem_in >> (4-pc[1:0])*8 | buffer
<label>_push
	rsp -= 4
	mem_out <- pc
	mem_address <- rsp[31:2]; mem_write
	pc <- buffer
	goto ifetch


<label> ;  p <- <label>
	mem_address <- pc[31:2]; mem_read
	buffer <- mem_in << pc[1:0]*8
	pc += 4
	if pc[1:0] == 0; goto <label> ;_jump
	mem_address <- pc[31:2]; mem_read
	buffer <- mem_in >> (4-pc[1:0])*8 | buffer
<label> ;_jump
	pc <- buffer
	goto ifetch


next <label>  if R != 0 then; R <- R - 1; p <- <label>; else returnStack.pop()
	mem_address <- pc[31:2]; mem_read
	buffer <- mem_in << pc[1:0]*8
	pc += 4
	if pc[1:0] == 0; goto next_cond
	mem_address <- pc[31:2]; mem_read
	buffer <- mem_in >> (4-pc[1:0])*8 | buffer
next_cond
	if R == 0; goto next_return
	ALU <- R; ALU <- -1; +; R <- ALU
	pc <- buffer
	goto ifetch
next_return
	rsp += 4
	goto ifetch


if <label>  if dataStack.pop() == 0 then p <- <label>
	mem_address <- dsp[31:2]; mem_read
	buffer <- mem_in
	if buffer == 0; goto if_success
	pc += 4
	goto ifetch
if_success
	mem_address <- pc[31:2]; mem_read
	buffer <- mem_in << pc[1:0]*8
	pc += 4
	if pc[1:0] == 0; goto if_cond
	mem_address <- pc[31:2]; mem_read
	buffer <- mem_in >> (4-pc[1:0])*8 | buffer
	pc <- buffer
	goto ifetch


-if <label>  if dataStack.pop() == 0 then p <- <label>
	mem_address <- dsp[31:2]; mem_read
	buffer <- mem_in
	if buffer[31] == 0; goto -if_success
	pc += 4
	goto ifetch
-if_success
	mem_address <- pc[31:2]; mem_read
	buffer <- mem_in << pc[1:0]*8
	pc += 4
	if pc[1:0] == 0; goto if_cond
	mem_address <- pc[31:2]; mem_read
	buffer <- mem_in >> (4-pc[1:0])*8 | buffer
	pc <- buffer
	goto ifetch


halt
	goto 0


>r  dataStack.push(returnStack.pop())
	mem_out <- S
	dsp -= 4
	mem_address <- dsp[31:2]; mem_write
	S <- T
	T <- R
	mem_address <- rsp[31:2]; mem_read
	R <- mem_in
	rsp += 4
	goto ifetch


r>  returnStack.push(dataStack.pop())
	mem_put <- R
	rsp -= 4
	mem_address <- rsp[31:2]; mem_write
	R <- T
	T <- S
	mem_address <- dsp[31:2]; mem_read
	S <- mem_in
	dsp += 4
	goto ifetch
