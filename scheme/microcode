cmd00000000: # <value>  dataStack.push(<value>)
    carry <- 0
    dsp -= 4
    mem_out <- S
    mem_address <- dsp[31:2]
    mem_write
    S <- T
    mem_address <- pc[31:2]
    mem_read
    T <- mem_in << pc[1:0]*8
    pc += 4
    if pc[1:0] == 0; goto ifetch
    mem_address <- pc[31:2]
    mem_read
    T <- mem_in >> (4-pc[1:0])*8 | T
    goto ifetch

cmd00000001: # @p  dataStack.push(mem[<address>])
    carry <- 0
    dsp -= 4
    mem_out <- S
    mem_address <- dsp[31:2]
    mem_write
    S <- T
    mem_address <- pc[31:2]
    mem_read
    buffer <- mem_in << pc[1:0]*8
    pc += 4
    if pc[1:0] == 0; goto @p_fetch
    mem_address <- pc[31:2]
    mem_read
    buffer <- mem_in >> (4-pc[1:0])*8 | buffer
